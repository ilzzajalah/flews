rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProject(data, userId) {
      return data.keys().hasAll([
        'userId', 'name', 'aspectRatio', 'width', 'height', 'fps',
        'durationMs', 'backgroundColor', 'layersJson', 'createdAt', 'updatedAt'
      ])
      && data.userId == userId
      && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.aspectRatio is string && data.aspectRatio.size() <= 20
      && data.width is int && data.width > 0 && data.width <= 7680
      && data.height is int && data.height > 0 && data.height <= 4320
      && data.fps is int && data.fps > 0 && data.fps <= 120
      && data.durationMs is int && data.durationMs > 0 && data.durationMs <= 3600000
      && data.backgroundColor is string && data.backgroundColor.size() <= 16
      && data.layersJson is string && data.layersJson.size() <= 1048576
      && data.createdAt is timestamp && data.createdAt <= request.time
      && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/projects/{projectId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidProject(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidProject(request.resource.data, userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }
  }
}
